SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uncomment and configure to use PostgreSQL on the company server:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/gestor_servicos

# IA para padronizar o relato das OS (opcional). Sem provedor, o botão
# "Padronizar relato" fica indisponível e o resto do app funciona igual.
#
# Opção A — Anthropic direto (cobrança em USD no console.anthropic.com):
# RELATO_IA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# Opção B — AWS Bedrock (cobrança na fatura da AWS, aceita pagamento BR):
# RELATO_IA_PROVEDOR=bedrock
# AWS_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# RELATO_IA_MODELO=us.anthropic.claude-haiku-4-5   # inference profile do console Bedrock

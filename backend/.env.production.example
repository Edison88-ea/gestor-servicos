# Copie para .env no servidor de produção e preencha os valores reais.
# NUNCA reutilize os valores de exemplo abaixo, nem comite o .env real no git.
#
# No Render essas variáveis são definidas pelo render.yaml / painel, não por um
# arquivo .env. Este exemplo serve para deploy manual (VPS / servidor da empresa).

# Gere uma chave nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-gerada-com-o-comando-acima

DEBUG=False

# Domínio(s) reais pelos quais a empresa vai acessar o sistema.
# No Render pode ser ".onrender.com" (o subdomínio é injetado automaticamente).
ALLOWED_HOSTS=gestor.suaempresa.com.br

# Mesmos domínios, com esquema, para CSRF do admin / browsable API.
CSRF_TRUSTED_ORIGINS=https://gestor.suaempresa.com.br

# Frontend e API são servidos pelo mesmo domínio, então CORS normalmente não é
# necessário. Preencha só se o frontend for hospedado em outro domínio.
# CORS_ALLOWED_ORIGINS=https://gestor.suaempresa.com.br

# PostgreSQL. No Neon: Dashboard > Connection Details > string "pooled".
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# Onde salvar fotos/assinaturas. Em disco persistente (Render Disk / volume do
# servidor), aponte para o caminho do volume. Sem isso, os arquivos somem a cada
# deploy/restart.
# MEDIA_ROOT=/var/data/media

# Superusuário criado automaticamente no deploy (management command
# bootstrap_admin). Rode uma vez e depois pode remover a senha do painel.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=voce@suaempresa.com.br

# IA para padronizar o relato das OS (opcional).
# Anthropic direto:
# RELATO_IA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Ou AWS Bedrock (recomendado no Brasil — cobrança na fatura da AWS):
# RELATO_IA_PROVEDOR=bedrock
# AWS_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# RELATO_IA_MODELO=us.anthropic.claude-haiku-4-5
